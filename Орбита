<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#02060E">
  <title>Орбита — личная страница</title>

  <style>
    /* ==========================================================
       1. ПЕРЕМЕННЫЕ И БАЗОВЫЕ СТИЛИ
       ========================================================== */
    :root {
      --space: #02060E;      /* глубокий тёмный */
      --blue: #0355C5;       /* насыщенный синий */
      --magenta: #9303C5;    /* неоновый фиолетовый */
      --text: #ffffff;
      --text-soft: rgba(255, 255, 255, 0.78);
      --glass-bg: rgba(8, 18, 40, 0.45);
      --glass-border: rgba(255, 255, 255, 0.14);
      --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      height: 100%;
    }

    body {
      margin: 0;
      min-height: 100%;
      color: var(--text);
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      line-height: 1.6;
      background-color: var(--space);
      /* Туманности: мягкие цветные пятна поверх тёмного фона */
      background-image:
        radial-gradient(ellipse 80% 50% at 15% 10%, rgba(3, 85, 197, 0.35), transparent 70%),
        radial-gradient(ellipse 70% 45% at 90% 85%, rgba(147, 3, 197, 0.32), transparent 70%),
        radial-gradient(ellipse 60% 40% at 50% 50%, rgba(3, 85, 197, 0.10), transparent 75%);
      background-attachment: fixed;
      overflow-x: hidden;
    }

    /* Холст со звёздами лежит под всем содержимым */
    #starfield {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    /* Весь контент выше холста */
    .page {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      min-height: 100dvh;
      padding-left: env(safe-area-inset-left, 0px);
      padding-right: env(safe-area-inset-right, 0px);
    }

    /* Видимый фокус для клавиатуры и доступности */
    :focus-visible {
      outline: 2px solid #ffffff;
      outline-offset: 3px;
    }

    /* ==========================================================
       2. КНОПКИ (общий стиль для всех кнопок на сайте)
       ========================================================== */
    .btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 28px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 999px;
      color: var(--text);
      font: inherit;
      font-weight: 600;
      letter-spacing: 0.02em;
      text-decoration: none;
      cursor: pointer;
      /* Градиент шире кнопки в 3 раза — его смещение создаёт эффект перелива */
      background: linear-gradient(120deg, var(--space), var(--blue), var(--magenta), var(--blue), var(--space));
      background-size: 300% 300%;
      background-position: 0% 50%;
      box-shadow: 0 0 14px rgba(3, 85, 197, 0.45), 0 0 28px rgba(147, 3, 197, 0.25);
      animation: gradientFlow 8s ease-in-out infinite;
      transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
    }

    /* Медленный постоянный перелив в состоянии покоя */
    @keyframes gradientFlow {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* При наведении или нажатии: перелив быстрее, кнопка растёт и светится */
    .btn:hover,
    .btn:active,
    .btn:focus-visible {
      transform: scale(1.05);
      border-color: rgba(255, 255, 255, 0.5);
      animation-duration: 2.5s;
      box-shadow: 0 0 20px rgba(3, 85, 197, 0.8), 0 0 42px rgba(147, 3, 197, 0.6);
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn .chevron {
      width: 10px;
      height: 10px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg) translateY(-2px);
      transition: transform 0.35s var(--ease);
    }

    /* Стрелка переворачивается, когда меню открыто */
    .btn[aria-expanded="true"] .chevron {
      transform: rotate(225deg) translateY(-2px);
    }

    /* ==========================================================
       3. ШАПКА
       ========================================================== */
    .header {
      position: sticky;
      top: 0;
      z-index: 20;
      padding: calc(env(safe-area-inset-top, 0px) + 12px) 16px 12px;
      background: rgba(2, 6, 14, 0.55);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--glass-border);
    }

    .header__inner {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 960px;
      margin: 0 auto;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--text);
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-decoration: none;
    }

    /* Логотип: планета с орбитой, нарисованная на CSS */
    .logo__mark {
      position: relative;
      width: 30px;
      height: 30px;
      flex-shrink: 0;
    }

    .logo__planet {
      position: absolute;
      inset: 7px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #5aa2ff, var(--blue) 55%, var(--magenta));
      box-shadow: 0 0 12px rgba(3, 85, 197, 0.9);
    }

    .logo__orbit {
      position: absolute;
      inset: 0;
      border: 1.5px solid rgba(255, 255, 255, 0.7);
      border-radius: 50%;
      transform: rotate(-25deg) scaleY(0.38);
      animation: orbitPulse 4s ease-in-out infinite;
    }

    @keyframes orbitPulse {
      0%, 100% { border-color: rgba(255, 255, 255, 0.45); }
      50%      { border-color: rgba(255, 255, 255, 0.95); }
    }

    /* Кнопка-бургер */
    .burger {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 46px;
      height: 46px;
      padding: 0;
      border-radius: 50%;
    }

    .burger span {
      display: block;
      width: 20px;
      height: 2px;
      border-radius: 2px;
      background: #ffffff;
      transition: transform 0.35s var(--ease), opacity 0.25s var(--ease);
    }

    /* Бургер превращается в крестик */
    .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* ==========================================================
       4. ВЫПАДАЮЩИЕ ПАНЕЛИ (меню шапки и соцсети)
       Закрыты: прозрачные, смещены вверх, чуть уменьшены.
       Открыты: плавно выплывают сверху вниз (transition, ease-out).
       ========================================================== */
    .dropdown {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-16px) scale(0.96);
      transform-origin: top center;
      transition:
        opacity 0.35s ease-out,
        transform 0.35s ease-out,
        visibility 0s linear 0.35s; /* скрываем после окончания затухания */
    }

    .dropdown.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0) scale(1);
      transition:
        opacity 0.35s ease-out,
        transform 0.35s ease-out,
        visibility 0s linear 0s;
    }

    /* Стеклянная поверхность (общая для панелей и карточки) */
    .glass {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      backdrop-filter: blur(18px) saturate(140%);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }

    /* Меню шапки */
    .nav-menu {
      position: absolute;
      top: calc(100% + 14px);
      right: 0;
      width: min(260px, calc(100vw - 32px));
      padding: 10px;
      border-radius: 20px;
      z-index: 30;
    }

    .nav-menu a {
      display: block;
      padding: 13px 16px;
      border-radius: 14px;
      color: var(--text);
      font-weight: 500;
      text-decoration: none;
      transition: background-color 0.25s ease-out, transform 0.25s ease-out;
    }

    .nav-menu a:hover,
    .nav-menu a:active {
      background: linear-gradient(120deg, rgba(3, 85, 197, 0.55), rgba(147, 3, 197, 0.55));
      transform: translateX(4px);
    }

    /* ==========================================================
       5. БЛОК «ОБО МНЕ»
       ========================================================== */
    .main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px 16px 48px;
    }

    .about {
      width: 100%;
      max-width: 520px;
      padding: 36px 26px 32px;
      border-radius: 28px;
      text-align: center;
    }

    /* Аватар-заглушка: можно заменить на <img> */
    .about__avatar {
      width: 92px;
      height: 92px;
      margin: 0 auto 20px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 28%),
        linear-gradient(135deg, var(--blue), var(--magenta));
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.12), 0 0 32px rgba(147, 3, 197, 0.6);
    }

    .about__title {
      margin: 0 0 14px;
      font-size: clamp(1.7rem, 7vw, 2.3rem);
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.01em;
    }

    .about__text {
      margin: 0 0 28px;
      color: var(--text-soft);
      font-size: 1.02rem;
    }

    /* ==========================================================
       6. СОЦСЕТИ (выпадающая панель под кнопкой)
       ========================================================== */
    .social {
      position: relative;
      display: inline-block;
      width: 100%;
      max-width: 320px;
    }

    .social .btn {
      width: 100%;
    }

    .social-menu {
      position: absolute;
      top: calc(100% + 14px);
      left: 0;
      right: 0;
      padding: 10px;
      border-radius: 22px;
      text-align: left;
      z-index: 15;
    }

    /* Пункт соцсети: общий стиль для ссылок и для кнопки Discord */
    .social-item {
      display: flex;
      align-items: center;
      gap: 14px;
      width: 100%;
      padding: 12px 14px;
      border: 0;
      border-radius: 16px;
      background: transparent;
      color: var(--text);
      font: inherit;
      text-align: left;
      text-decoration: none;
      cursor: pointer;
      /* Пункты выплывают с небольшой задержкой друг за другом */
      opacity: 0;
      transform: translateY(-10px);
      transition: opacity 0.35s ease-out, transform 0.35s ease-out, background-color 0.25s ease-out;
    }

    .social-menu.is-open .social-item {
      opacity: 1;
      transform: translateY(0);
    }

    .social-menu.is-open .social-item:nth-child(1) { transition-delay: 0.05s; }
    .social-menu.is-open .social-item:nth-child(2) { transition-delay: 0.10s; }
    .social-menu.is-open .social-item:nth-child(3) { transition-delay: 0.15s; }

    .social-item:hover,
    .social-item:active {
      background: linear-gradient(120deg, rgba(3, 85, 197, 0.55), rgba(147, 3, 197, 0.55));
    }

    /* Значок соцсети с логотипом внутри */
    .social-item .badge {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      flex-shrink: 0;
      border-radius: 13px;
      background: linear-gradient(135deg, var(--blue), var(--magenta));
      box-shadow: 0 0 14px rgba(3, 85, 197, 0.6);
    }

    .social-item .badge svg {
      width: 24px;
      height: 24px;
      fill: #ffffff;
    }

    /* Два ряда текста: название сети и ваш ник */
    .social-item .label {
      display: flex;
      flex-direction: column;
      line-height: 1.3;
      min-width: 0;
    }

    .social-item .name {
      font-weight: 700;
    }

    .social-item .nick {
      color: var(--text-soft);
      font-size: 0.92rem;
      overflow-wrap: anywhere;
    }

    /* ==========================================================
       7. ПОДВАЛ
       ========================================================== */
    .footer {
      padding: 18px 16px calc(env(safe-area-inset-bottom, 0px) + 18px);
      text-align: center;
      color: rgba(255, 255, 255, 0.55);
      font-size: 0.85rem;
    }

    /* ==========================================================
       8. АДАПТИВНОСТЬ И УМЕНЬШЕННОЕ ДВИЖЕНИЕ
       ========================================================== */
    @media (min-width: 700px) {
      .about {
        padding: 48px 44px 42px;
      }
    }

    @media (max-width: 360px) {
      .logo {
        letter-spacing: 0.18em;
        font-size: 1.05rem;
      }
      .about {
        padding: 30px 18px 26px;
      }
    }

    /* Для людей, которые отключили анимации в системе */
    @media (prefers-reduced-motion: reduce) {
      .btn,
      .logo__orbit {
        animation: none;
      }
      .dropdown,
      .dropdown.is-open,
      .social-item {
        transition-duration: 0.01s;
        transition-delay: 0s !important;
      }
    }
  </style>
</head>

<body>
  <!-- Холст для анимированных звёзд -->
  <canvas id="starfield" aria-hidden="true"></canvas>

  <div class="page">

    <!-- ===== ШАПКА ===== -->
    <header class="header">
      <div class="header__inner">
        <a class="logo" href="#top" aria-label="Орбита — на главную">
          <span class="logo__mark" aria-hidden="true">
            <span class="logo__orbit"></span>
            <span class="logo__planet"></span>
          </span>
          ОРБИТА
        </a>

        <!-- Кнопка меню (бургер) -->
        <button class="btn burger" id="burgerBtn" type="button"
                aria-label="Открыть меню" aria-expanded="false" aria-controls="navMenu">
          <span></span><span></span><span></span>
        </button>

        <!-- Выпадающее меню шапки -->
        <nav class="dropdown glass nav-menu" id="navMenu" aria-label="Главное меню">
          <a href="#about">Обо мне</a>
          <a href="#about" id="menuSocialLink">Мои соцсети</a>
        </nav>
      </div>
    </header>

    <!-- ===== ОСНОВНОЙ КОНТЕНТ ===== -->
    <main class="main" id="top">
      <!-- Блок «Обо мне» в стиле Glassmorphism -->
      <section class="glass about" id="about">
        <div class="about__avatar" aria-hidden="true"></div>

        <h1 class="about__title">Всем привет!</h1>

        <p class="about__text">
          Я Алексей, мне 14 лет. Я начинающий кодер, а также художник.
          В будущем я планирую переделать этот сайт во что-то более масштабное.
          Удачи вам!
        </p>

        <!-- Кнопка «Мои соцсети» + выпадающая панель -->
        <div class="social" id="social">
          <button class="btn" id="socialBtn" type="button"
                  aria-expanded="false" aria-controls="socialMenu">
            Мои соцсети
            <span class="chevron" aria-hidden="true"></span>
          </button>

          <div class="dropdown glass social-menu" id="socialMenu">

            <!-- Discord: ссылки на профиль по нику нет, поэтому по тапу ник копируется -->
            <button class="social-item" id="discordItem" type="button" aria-label="Discord, скопировать ник zex0oo">
              <span class="badge" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M19.3 5.3A16.4 16.4 0 0 0 15.2 4l-.5 1a15.2 15.2 0 0 0-5.4 0l-.5-1a16.4 16.4 0 0 0-4.1 1.3C2 9.2 1.3 13 1.6 16.7a16.6 16.6 0 0 0 5 2.5l1.1-1.7a10.7 10.7 0 0 1-1.7-.8l.4-.3a11.8 11.8 0 0 0 10.2 0l.4.3c-.5.3-1.1.6-1.7.8l1.1 1.7a16.5 16.5 0 0 0 5-2.5c.4-4.3-.7-8.1-3.1-11.4zM8.8 14.8a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6zm6.4 0a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z"/>
                </svg>
              </span>
              <span class="label">
                <span class="name">Discord</span>
                <span class="nick" id="discordNick">zex0oo</span>
              </span>
            </button>

            <!-- Telegram -->
            <a class="social-item" href="https://t.me/T0leranV1p" target="_blank" rel="noopener noreferrer">
              <span class="badge" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M2.5 11.2 21 4c.9-.3 1.5.2 1.3 1.2l-3.1 14.2c-.2.9-.7 1.1-1.5.7l-4.8-3.5-2.4 2.3c-.3.3-.5.5-1 .5l.4-4.8 8.8-8c.4-.3-.1-.5-.6-.2L7.2 13.3l-4.6-1.4c-.9-.3-.9-.9-.1-1.2z"/>
                </svg>
              </span>
              <span class="label">
                <span class="name">Telegram</span>
                <span class="nick">@T0leranV1p</span>
              </span>
            </a>

            <!-- YouTube -->
            <a class="social-item" href="https://www.youtube.com/@SoonZaki" target="_blank" rel="noopener noreferrer">
              <span class="badge" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.6 2.6 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.6 2.6 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3L10 15z"/>
                </svg>
              </span>
              <span class="label">
                <span class="name">YouTube</span>
                <span class="nick">@SoonZaki</span>
              </span>
            </a>

          </div>
        </div>
      </section>
    </main>

    <!-- ===== ПОДВАЛ ===== -->
    <footer class="footer">© 2026 Орбита. Все права защищены.</footer>
  </div>

  <script>
    /* ==========================================================
       JAVASCRIPT: меню, соцсети, копирование ника, звёздное небо
       ========================================================== */

    /* ---------- 1. Управление выпадающими элементами ---------- */

    // Находим элементы страницы
    var burgerBtn = document.getElementById('burgerBtn');
    var navMenu = document.getElementById('navMenu');
    var socialBtn = document.getElementById('socialBtn');
    var socialMenu = document.getElementById('socialMenu');
    var social = document.getElementById('social');
    var menuSocialLink = document.getElementById('menuSocialLink');

    // Открывает или закрывает панель. Кнопка и панель всегда синхронизированы
    function setOpen(button, panel, shouldOpen) {
      panel.classList.toggle('is-open', shouldOpen);
      button.setAttribute('aria-expanded', String(shouldOpen));
    }

    // Закрывает оба выпадающих элемента сразу
    function closeAll() {
      setOpen(burgerBtn, navMenu, false);
      setOpen(socialBtn, socialMenu, false);
      burgerBtn.setAttribute('aria-label', 'Открыть меню');
    }

    // Клик по бургеру: переключаем меню шапки, соцсети закрываем
    burgerBtn.addEventListener('click', function () {
      var willOpen = !navMenu.classList.contains('is-open');
      setOpen(socialBtn, socialMenu, false);
      setOpen(burgerBtn, navMenu, willOpen);
      burgerBtn.setAttribute('aria-label', willOpen ? 'Закрыть меню' : 'Открыть меню');
    });

    // Клик по «Мои соцсети»: переключаем панель, меню шапки закрываем
    socialBtn.addEventListener('click', function () {
      var willOpen = !socialMenu.classList.contains('is-open');
      setOpen(burgerBtn, navMenu, false);
      burgerBtn.setAttribute('aria-label', 'Открыть меню');
      setOpen(socialBtn, socialMenu, willOpen);
    });

    // Пункт «Мои соцсети» в меню шапки: закрываем меню и открыв
